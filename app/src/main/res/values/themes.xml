<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Listropik" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Default window background -->
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Android 12+ Splash Screen background and user's logo icon -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
